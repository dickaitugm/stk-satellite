{
    "name": "stk-satellite",
    "private": true,
    "version": "25.0.0",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build:react": "vite build",
        "start": "electron .",
        "dev:electron": "cross-env NODE_ENV=development concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "npm run build:react && electron-builder --win --x64"
    },
    "dependencies": {
        "autoprefixer": "^10.4.21",
        "axios": "^1.12.2",
        "daisyui": "^5.0.9",
        "leaflet": "^1.9.4",
        "postcss": "^8.5.3",
        "proj4": "^2.20.0",
        "proj4leaflet": "^1.0.2",
        "react": "^19.0.0-rc.1",
        "react-dom": "^19.0.0-rc.1",
        "react-leaflet": "^5.0.0-rc.2",
        "satellite.js": "^6.0.1",
        "systeminformation": "^5.27.10",
        "tailwindcss": "^4.0.15",
        "worldwindjs": "^1.9.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@tailwindcss/vite": "^4.0.15",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "cross-env": "^10.1.0",
        "electron": "^35.0.3",
        "electron-builder": "^25.1.8",
        "eslint": "^9.21.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^15.15.0",
        "vite": "^6.2.0",
        "wait-on": "^9.0.3"
    },
    "build": {
        "appId": "com.stksatellite.app",
        "productName": "STK Satellite",
        "win": {
            "target": "nsis",
            "icon": "icon.ico"
        },
        "files": [
            "main.js",
            "preload.js",
            "dist/**/*",
            "src/**/*"
        ]
    }
}
