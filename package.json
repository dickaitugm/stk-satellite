{
    "name": "stk-satellite",
    "version": "25.0.0",
    "private": true,
    "type": "module",
    "main": "main/main.js",
    "scripts": {
        "dev": "vite",
        "build:react": "vite build",
        "start": "electron .",
        "dev:electron": "cross-env NODE_ENV=development concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "npm run build:react && electron-builder --win --x64"
    },
    "dependencies": {
        "axios": "^1.13.2",
        "dayjs": "^1.11.19",
        "electron-is-dev": "^3.0.1",
        "immer": "^10.2.0",
        "lucide-react": "^0.553.0",
        "proj4": "^2.20.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "satellite.js": "^6.0.1",
        "systeminformation": "^5.27.11",
        "worldwindjs": "^1.9.5",
        "zustand": "^4.5.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.17",
        "@types/react": "^19.2.4",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.22",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "daisyui": "^5.5.3",
        "electron": "^35.7.5",
        "electron-builder": "^25.1.8",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.17",
        "vite": "^6.4.1",
        "wait-on": "^9.0.3"
    },
    "build": {
        "appId": "com.stksatellite.app",
        "productName": "STK Satellite",
        "files": [
            "main/**/*",
            "dist/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "icon.ico"
        }
    }
}
